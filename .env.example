TELEGRAM_BOT_TOKEN=your_telegram_token_here
# YouTube Data API v3 (опционально). Заголовок и описание к субтитрам; без ключа — только субтитры.
YOUTUBE_API_KEY=
# Netscape cookies.txt для yt-dlp, если YouTube требует вход («Sign in to confirm you're not a bot»).
# Экспорт: расширение «Get cookies.txt LOCALLY», вкладка инкогнито с авторизацией на youtube.com.
YOUTUBE_COOKIE_FILE=
GITHUB_TOKEN=your_github_token_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
LOG_LEVEL=INFO

# HTTPS-URL задеплоенного mini_app/index.html.
# Если пусто — WebApp-кнопка «📖 Книга рецептов» просто не появится
# ни в /menu, ни в главной Reply-клавиатуре.
# Пример: https://your-project.vercel.app/
WEBAPP_URL=

ENVIRONMENT=development
