TELEGRAM_BOT_TOKEN=your_telegram_token_here
# YouTube Data API v3 (заголовок и описание). Для парсинга YouTube URL ключ обязателен.
YOUTUBE_API_KEY=
# Токен Apify (console.apify.com → Settings → API & Integrations). Без префикса Bearer.
APIFY_API_TOKEN=
# Instagram sessionid для Apify Actor apple_yang~instagram-transcripts-scraper (опционально).
INSTAGRAM_SESSION_ID=
# Каталог для сохранения изображений рецептов (Railway: том /images). Альтернатива: REMY_IMAGES_DIR.
IMAGES_DIR=/images
# Hugging Face API токен для FLUX.1-dev (провайдер fal-ai через InferenceClient).
# Без ключа генерация отключена; og:image с сайтов по-прежнему скачивается локально.
HF_API_KEY=
# Supabase Storage: создайте публичный бакет recipe-images (Dashboard → Storage → New bucket).
# Устарело (оставлено для совместимости; yt-dlp в проекте не используется).
YOUTUBE_COOKIE_FILE=
GITHUB_TOKEN=your_github_token_here
# GitHub Models: модель нормализации (gpt-5-mini, gpt-4o-mini, openai/gpt-5-mini на models.github.ai)
GITHUB_MODEL=gpt-5-mini
# Для reasoning-моделей: minimal | low | medium | high
GITHUB_REASONING_EFFORT=medium
# Лимит: 1 ссылка на пользователя раз в N секунд (по умолчанию 180 = 3 мин).
URL_RATE_LIMIT_SECONDS=180
# Макс. длина видео для Whisper (сек). Длиннее — только описание/субтитры без транскрипции.
MAX_VIDEO_DURATION_SECONDS=120
# Одновременных тяжёлых видео-задач (yt-dlp + Whisper) на весь инстанс бота.
MAX_CONCURRENT_VIDEO_JOBS=3
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
LOG_LEVEL=INFO

# HTTPS-URL задеплоенного mini_app/index.html.
# Если пусто — WebApp-кнопка «📖 Книга рецептов» просто не появится
# ни в /menu, ни в главной Reply-клавиатуре.
# Пример: https://your-project.vercel.app/
WEBAPP_URL=

ENVIRONMENT=development
