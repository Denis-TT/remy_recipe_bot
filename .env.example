TELEGRAM_BOT_TOKEN=your_telegram_token_here
# YouTube Data API v3 (заголовок и описание). Для парсинга YouTube URL ключ обязателен.
YOUTUBE_API_KEY=
# Прокси для субтитров (youtube-transcript-api). Один URL или несколько через запятую — ротация при 429.
# Формат: http://USER:PASS@HOST:PORT (как в requests; для Webshare и др. резидентских обычно HTTP к хосту провайдера).
# Пример Webshare: http://yourname-rotate:password@p.webshare.io:80/
# Символы @ : / и т.д. в логине/пароле — закодируйте (например urllib.parse.quote).
YOUTUBE_PROXY_URL=
# Устарело (оставлено для совместимости; yt-dlp в проекте не используется).
YOUTUBE_COOKIE_FILE=
GITHUB_TOKEN=your_github_token_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
LOG_LEVEL=INFO

# HTTPS-URL задеплоенного mini_app/index.html.
# Если пусто — WebApp-кнопка «📖 Книга рецептов» просто не появится
# ни в /menu, ни в главной Reply-клавиатуре.
# Пример: https://your-project.vercel.app/
WEBAPP_URL=

ENVIRONMENT=development
